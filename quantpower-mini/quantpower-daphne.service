[Unit]

Description=QuantPower Daphne

After=network.target



[Service]

User=ubuntu

Group=www-data



WorkingDirectory=/var/www/quantpower/QuantPower_mini/quantpower-mini



EnvironmentFile=/var/www/quantpower/QuantPower_mini/quantpower-mini/.env

ExecStart=/var/www/quantpower/QuantPower_mini/venv/bin/daphne \

    -b 127.0.0.1 \

    -p 8000 \

    config.asgi:application



Restart=always

RestartSec=5



[Install]

WantedBy=multi-user.target
